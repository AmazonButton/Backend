# Server Config
PORT=3000
NODE_ENV=development

# Supabase Credentials (Next.js & Backend Compatible)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Google OAuth Security
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Database Connection (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# JWT Security
JWT_SECRET="replace_with_your_super_secret_jwt_key"
JWT_EXPIRES_IN="7d"

# IoT Device Security (Shared HMAC Secret Key)
HMAC_SECRET_KEY="replace_with_your_iot_device_hmac_secret_key"

# Cloudinary Storage Config (Optional / Image Uploads)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"


OTP_PEPPER="replace_with_your_otp_pepper_dedicated_secret_key"
# Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# Didit eKYC Verification Config
DIDIT_BASE_URL="https://verification.didit.me/v3"
DIDIT_DELETE_URL="https://verification.didit.me/v1"
DIDIT_API_KEY="your_didit_api_key"
DIDIT_WORKFLOW_ID="your_didit_workflow_id"
DIDIT_WEBHOOK_SECRET="your_didit_webhook_secret"
DIDIT_CALLBACK_URL="https://buttontdash.vercel.app/verification/callback"

# Bank Account 2.000 VND Ownership Verification
BANK_VERIFICATION_AMOUNT_VND=2000
BANK_VERIFICATION_EXPIRY_MINUTES=30
BANK_VERIFICATION_PROVIDER=payos
BANK_VERIFICATION_CALLBACK_URL="https://buttontdash.vercel.app/api/v1/webhooks/bank-verification"
BANK_ACCOUNT_ENCRYPTION_KEY="replace_with_32_byte_hex_encryption_key"
BANK_ACCOUNT_HASH_SALT="replace_with_salt_for_account_hash"
BANK_VERIFICATION_WEBHOOK_SECRET="replace_with_bank_webhook_hmac_secret"
PLATFORM_BANK_ACCOUNT_NUMBER="your_platform_bank_account_number"
PLATFORM_BANK_BIN="970422"

# VietQR Open API Credentials (for Account Name Lookup)
VIETQR_CLIENT_ID="your_vietqr_client_id"
VIETQR_API_KEY="your_vietqr_api_key"

# Redis Cache & Rate Limiting (Multi-instance counter)
REDIS_URL="redis://localhost:6379"

