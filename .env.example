# Server Config
PORT=3000
NODE_ENV=development

# Supabase Credentials (Next.js & Backend Compatible)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Database Connection (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# JWT Security
JWT_SECRET="replace_with_your_super_secret_jwt_key"
JWT_EXPIRES_IN="7d"

# IoT Device Security (Shared HMAC Secret Key)
HMAC_SECRET_KEY="replace_with_your_iot_device_hmac_secret_key"

# Cloudinary Storage Config (Optional / Image Uploads)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

