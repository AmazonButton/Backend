# Server Port
PORT=5000

# Database URL:
# For Local SQLite: "file:./dev.db"
# For Production PostgreSQL: "postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets
JWT_SECRET="replace_with_your_super_secret_jwt_key_at_least_32_chars"
JWT_REFRESH_SECRET="replace_with_your_super_secret_refresh_key_at_least_32_chars"

# Device Master HMAC Secret
DEVICE_DEFAULT_SECRET="smart_order_device_master_secret_2026"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN="http://localhost:5173,https://your-frontend-domain.vercel.app"

# Environment
NODE_ENV="development"
