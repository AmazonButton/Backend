  <diagram id="page_st05_order" name="[ST05] Order Status &amp; Payment">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1580" pageHeight="1160" math="0" shadow="0">
