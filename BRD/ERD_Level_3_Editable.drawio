          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s6_e3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" source="s6_st_open" target="s6_st_handed" value="Direct Manager Confirmation">
