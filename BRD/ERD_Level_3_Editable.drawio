        <mxCell id="page_seq_08_pairing_config_msg_57" value="8. createSessionAtomicTx(&lt;br/&gt;deviceId, tokenHash, sessionId,&lt;br/&gt;sessionHash, buttonId, +10m)" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.3;html=1;fontSize=9.5;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center;" edge="1" parent="1">
