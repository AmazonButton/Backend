        <mxCell id="page_st_sup4_user_platform_membership_note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11.5;fontColor=#000000;fillColor=#F8F9FA;strokeColor=#000000;strokeWidth=1.2;" value="&lt;b&gt;ST-SUP4 — Vòng đời Tài khoản (User.status) &amp; Quyền Platform (PlatformMembership.status)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;color:#333333&#39;&gt;Hai máy trạng thái độc lập | Khóa/mở khóa tài khoản (JWT Watermark + WS Kick) &amp; Bản ghi cấp quyền append-only (ACTIVE -&gt; REVOKED, KHÔNG thăng chức tuyến tính)&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="1420" x="50" y="18" as="geometry" />
        </mxCell>
        <mxCell id="f_usr" parent="1" style="swimlane;startSize=28;horizontal=1;rounded=1;arcSize=6;dashed=1;dashPattern=6 4;fillColor=#FAFAFA;strokeColor=#555555;strokeWidth=1.3;fontColor=#000000;fontStyle=1;fontSize=11;html=1;swimlaneFillColor=#FFFFFF;" value="Máy 1: User.status &amp; Watermark Thu hồi Phiên (Bảng users)" vertex="1">
          <mxGeometry height="620" width="680" x="48" y="96" as="geometry" />
        </mxCell>
        <mxCell id="u_init" parent="1" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry height="24" width="24" x="118" y="148" as="geometry" />
        </mxCell>
        <mxCell id="c_u" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;fontSize=9.5;" value="verify flow?" vertex="1">
          <mxGeometry height="44" width="44" x="278" y="138" as="geometry" />
        </mxCell>
        <mxCell id="u_pver" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;PENDING_VERIFICATION&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;&lt;font style=&#39;font-size:9.5px;color:#222222&#39;&gt;Chờ xác minh email/OTP&lt;br&gt;(xử lý trong auth.service)&lt;/font&gt;" vertex="1">
          <mxGeometry height="64" width="230" x="415" y="128" as="geometry" />
        </mxCell>
        <mxCell id="u_act" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;ACTIVE [Cho phép Đăng nhập &amp; Token]&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;&lt;font style=&#39;font-size:9.5px;color:#222222&#39;&gt;JwtStrategy &amp; handleConnection() kiểm tra:&lt;br&gt;status==ACTIVE &amp;&amp; iat &gt; max(tokensInvalidBefore,&lt;br&gt;passwordChangedAt)&lt;/font&gt;" vertex="1">
          <mxGeometry height="94" width="300" x="150" y="313" as="geometry" />
        </mxCell>
        <mxCell id="u_inact" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;INACTIVE [Khóa Tạm — Có thể Mở khóa lại]&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;&lt;font style=&#39;font-size:9.5px;color:#222222&#39;&gt;POST /admin/users/:id/toggle-status [SUPER_ADMIN];&lt;br&gt;nâng tokensInvalidBefore, revoke RefreshToken, bắn WS kick;&lt;br&gt;(vẫn mở khóa lại về ACTIVE nên KHÔNG nối Final)&lt;/font&gt;" vertex="1">
          <mxGeometry height="102" width="420" x="178" y="509" as="geometry" />
        </mxCell>
        <mxCell id="f_pm" parent="1" style="swimlane;startSize=28;horizontal=1;rounded=1;arcSize=6;dashed=1;dashPattern=6 4;fillColor=#FAFAFA;strokeColor=#555555;strokeWidth=1.3;fontColor=#000000;fontStyle=1;fontSize=11;html=1;swimlaneFillColor=#FFFFFF;" value="Máy 2: PlatformMembership.status (Bản ghi Cấp quyền Append-Only — KHÔNG xóa dòng)" vertex="1">
          <mxGeometry height="620" width="708" x="764" y="96" as="geometry" />
        </mxCell>
        <mxCell id="pm_init" parent="1" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry height="24" width="24" x="1106" y="148" as="geometry" />
        </mxCell>
        <mxCell id="pm_act" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;ACTIVE [roleCode ∈ {SUPER_ADMIN, SYSTEM_ADMIN, ADMIN, SYSTEM_STAFF}]&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;&lt;font style=&#39;font-size:9.5px;color:#222222&#39;&gt;POST /admin/users/:id/platform-role [SUPER_ADMIN];&lt;br&gt;Check: !isBootstrapAdminConflict &amp; !(SYSTEM_STAFF &amp;&amp; ownedStores&gt;0);&lt;br&gt;nâng watermark + ngắt socket để ép nhận quyền mới&lt;/font&gt;" vertex="1">
          <mxGeometry height="108" width="420" x="908" y="246" as="geometry" />
        </mxCell>
        <mxCell id="pm_rev" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;REVOKED [Hết hiệu lực / Đã thu hồi]&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;&lt;font style=&#39;font-size:9.5px;color:#222222&#39;&gt;DELETE /admin/users/:id/platform-role (hoặc bị ghi đè khi cấp role mới);&lt;br&gt;tự động nâng tokensInvalidBefore &amp; revoke RefreshToken;&lt;br&gt;effectiveRole hạ về STORE_OWNER hoặc CUSTOMER&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="420" x="908" y="470" as="geometry" />
        </mxCell>
        <mxCell id="pm_end" parent="1" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry height="28" width="28" x="1104" y="654" as="geometry" />
        </mxCell>
        <mxCell id="n_st_sup4" parent="1" style="rounded=1;arcSize=8;dashed=1;dashPattern=5 3;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#666666;strokeWidth=1.2;fontColor=#111111;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;Quy tắc Phân giải Quyền AuthorityPolicy (resolveAuthority):&lt;/b&gt;&lt;br&gt;• Thứ tự ưu tiên: &lt;b&gt;1. Bootstrap SuperAdmin&lt;/b&gt; (&lt;i&gt;SUPER_ADMIN_EMAILS / admin&lt;/i&gt;) → &lt;b&gt;2. PlatformMembership ACTIVE&lt;/b&gt; có độ ưu tiên cao nhất (&lt;i&gt;SUPER_ADMIN &amp;gt; SYSTEM_ADMIN &amp;gt; ADMIN &amp;gt; SYSTEM_STAFF&lt;/i&gt;) → &lt;b&gt;3. Sở hữu Store&lt;/b&gt; (&lt;code&gt;STORE_OWNER&lt;/code&gt;) → &lt;b&gt;4. Mặc định&lt;/b&gt; (&lt;code&gt;CUSTOMER&lt;/code&gt;).&lt;br&gt;• Không vẽ mô hình &quot;thăng chức tuyến tính&quot; (&lt;i&gt;CUSTOMER → STAFF → ADMIN&lt;/i&gt;) vì &lt;i&gt;PlatformMembership&lt;/i&gt; là bản ghi cấp quyền độc lập: cấp vai trò mới sẽ thu hồi (&lt;code&gt;REVOKED&lt;/code&gt;) bản ghi cũ và &lt;code&gt;INSERT&lt;/code&gt; một bản ghi mới hoàn toàn." vertex="1">
          <mxGeometry height="108" width="1424" x="48" y="736" as="geometry" />
        </mxCell>
        <mxCell id="page_st_sup4_user_platform_membership_t1" edge="1" parent="1" source="u_init" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.3;endArrow=open;endFill=0;fontColor=#000000;fontSize=9.5;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" target="c_u" value="register / googleLogin">
