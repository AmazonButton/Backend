        <mxCell id="a4_e4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" source="a4_dec_admin" target="a4_act_cas_claim" value="[Approve]">
          <mxGeometry relative="1" as="geometry" />
