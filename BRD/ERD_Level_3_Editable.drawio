        <mxCell id="chen_v2_202" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;align=left;verticalAlign=top;spacing=8;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;BẢNG CHÚ GIẢI KÝ PHÁP PETER CHEN (CHEN&#39;S ERD NOTATION LEGEND)&lt;/b&gt;&lt;br/&gt;&lt;hr/&gt;&lt;table style=&quot;width: 100%; font-size: 10px; text-align: left;&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;[Hình chữ nhật đơn]&lt;/b&gt;: Thực thể mạnh (Strong Entity)&lt;/td&gt;&lt;td&gt;&lt;b&gt;[Elip nét liền]&lt;/b&gt;: Thuộc tính đơn (Simple Attribute)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;[Hình chữ nhật kép]&lt;/b&gt;: Thực thể yếu (Weak Entity - cần thực thể chủ)&lt;/td&gt;&lt;td&gt;&lt;b&gt;[Chữ gạch chân]&lt;/b&gt;: Thuộc tính khóa chính (Primary Key)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;[Hình thoi đơn]&lt;/b&gt;: Mối quan hệ giữa các thực thể (Relationship)&lt;/td&gt;&lt;td&gt;&lt;b&gt;[Elip nét đứt]&lt;/b&gt;: Thuộc tính suy diễn (Derived Attribute)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;[Hình thoi kép]&lt;/b&gt;: Quan hệ định danh thực thể yếu (Identifying Rel)&lt;/td&gt;&lt;td&gt;&lt;b&gt;[Elip kép]&lt;/b&gt;: Thuộc tính đa trị (Multivalued Attribute)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;[Đường đơn]&lt;/b&gt;: Tham gia bộ phận (Partial Participation: min=0)&lt;/td&gt;&lt;td&gt;&lt;b&gt;[Elip nối elip con]&lt;/b&gt;: Thuộc tính phức hợp (Composite Attribute)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;[Đường đôi]&lt;/b&gt;: Tham gia toàn phần (Total Participation: min=1)&lt;/td&gt;&lt;td&gt;&lt;b&gt;1, N, M / (min, max)&lt;/b&gt;: Ràng buộc số lượng liên kết (Cardinality)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
