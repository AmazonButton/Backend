        <mxCell id="s6_e6" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" source="s6_st_duty_offline" target="s6_st_duty_online" value="Toggle Online [Shift Must Be OPEN]">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1000" y="660" />
              <mxPoint x="1000" y="640" />
