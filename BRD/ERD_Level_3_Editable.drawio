  <diagram id="page_act_store_payout" name="[ACT 4] Store Wallet Payout">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1520" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="a4_note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;fontColor=#333333;fillColor=#F8F9FA;strokeColor=#D5D5D5;strokeWidth=1;spacing=8;" value="&lt;b&gt;Activity: Store Wallet Payout &amp; Reconcile&lt;/b&gt;&lt;br&gt;Duyệt chi không đồng nghĩa chuyển tiền thành công. Tránh gọi API lặp khi timeout/403, giữ tiền đóng băng và đối soát lũy tiến." vertex="1">
          <mxGeometry x="40" y="20" width="1440" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pool_a4" parent="1" style="swimlane;startSize=30;horizontal=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=13;" value="ACTIVITY DIAGRAM: STORE WALLET PAYOUT &amp; RECONCILIATION" vertex="1">
          <mxGeometry x="40" y="80" width="1440" height="1100" as="geometry" />
        </mxCell>
        <mxCell id="lane_a4_owner" parent="pool_a4" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=11;collapsible=0;" value="Store Owner (Chủ cửa hàng)" vertex="1">
