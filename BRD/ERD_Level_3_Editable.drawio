          <mxGeometry x="380" y="30" width="380" height="1220" as="geometry" />
        </mxCell>
        <mxCell id="v_lane_bnk_payos" value="PayOS Banking Gateway (Cổng chuyển khoản Napas)" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;collapsible=0;" vertex="1" parent="pool_bnk">
          <mxGeometry x="760" y="30" width="380" height="1220" as="geometry" />
        </mxCell>
        <mxCell id="v_lane_bnk_cron" value="Verification Expiry Worker (Tiến trình quét hạn 24h)" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;collapsible=0;" vertex="1" parent="pool_bnk">
          <mxGeometry x="1140" y="30" width="380" height="1220" as="geometry" />
        </mxCell>
        <mxCell id="bnk_init" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="v_lane_bnk_owner">
          <mxGeometry x="176" y="55" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="st_bnk_unverified" value="&lt;b&gt;UNVERIFIED&lt;/b&gt;&lt;hr size=&quot;1&quot; style=&quot;margin: 3px 0;&quot;/&gt;&lt;div style=&quot;font-size: 10px; text-align: left;&quot;&gt;entry / Store registers bank account &amp;amp; holder name&lt;br/&gt;do / Encrypt AES-256-GCM; compute SHA-256 hash&lt;br/&gt;status / Account pending verification&lt;/div&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;verticalAlign=top;spacingTop=4;" vertex="1" parent="v_lane_bnk_owner">
          <mxGeometry x="80" y="115" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="st_bnk_pending_deposit" value="&lt;b&gt;PENDING_DEPOSIT&lt;/b&gt;&lt;hr size=&quot;1&quot; style=&quot;margin: 3px 0;&quot;/&gt;&lt;div style=&quot;font-size: 10px; text-align: left;&quot;&gt;entry / Generate random penny deposit (1,000-5,000 VND)&lt;br/&gt;do / Generate hashed OTP code&lt;br/&gt;exit / Dispatch micro-transfer via PayOS&lt;/div&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;verticalAlign=top;spacingTop=4;" vertex="1" parent="v_lane_bnk_security">
          <mxGeometry x="80" y="245" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="st_bnk_pending_otp" value="&lt;b&gt;PENDING_OTP_CONFIRMATION&lt;/b&gt;&lt;hr size=&quot;1&quot; style=&quot;margin: 3px 0;&quot;/&gt;&lt;div style=&quot;font-size: 10px; text-align: left;&quot;&gt;entry / Micro-deposit transferred via Napas 24/7&lt;br/&gt;do / Await store owner entering OTP from bank statement&lt;br/&gt;timer / 24-hour verification window&lt;/div&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;verticalAlign=top;spacingTop=4;" vertex="1" parent="v_lane_bnk_payos">
          <mxGeometry x="80" y="405" width="230" height="80" as="geometry" />
