  <diagram id="page_st01_store_subscription" name="[ST01] StoreSubscription State">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1360" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="page_st01_store_subscription_note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11.5;fontColor=#000000;fillColor=#F8F9FA;strokeColor=#000000;strokeWidth=1.2;" value="&lt;b&gt;ST01 — Vòng đời Một Bản ghi Gói Dịch vụ Cửa hàng (StoreSubscription)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;color:#333333&#39;&gt;DB chỉ ghi 2 giá trị status (&#39;ACTIVE&#39; | &#39;EXPIRED&#39;); isUpcoming &amp; isExpired tính động theo start_date/end_date; gia hạn sinh DÒNG MỚI (queued) chứ không biến dòng hiệu lực thành queued.&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="1260" x="50" y="18" as="geometry" />
        </mxCell>
        <mxCell id="s_init" parent="1" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry height="24" width="24" x="128" y="278" as="geometry" />
        </mxCell>
        <mxCell id="c_start" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;fontSize=9.5;" value="start_date &gt; now?" vertex="1">
          <mxGeometry height="44" width="44" x="318" y="268" as="geometry" />
        </mxCell>
        <mxCell id="s_upcoming" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;ACTIVE [isUpcoming = true]&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;&lt;font style=&#39;font-size:9.5px;color:#222222&#39;&gt;startDate = activeSub.end_date &gt; now()&lt;br&gt;entry / status = ACTIVE; chưa mở khóa đăng bán mới&lt;/font&gt;" vertex="1">
          <mxGeometry height="114" width="286" x="487" y="153" as="geometry" />
        </mxCell>
        <mxCell id="s_effective" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;ACTIVE [Effective: start &lt;= now &lt;= end]&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;&lt;font style=&#39;font-size:9.5px;color:#222222&#39;&gt;entry / mở khóa validateStoreCanListProducts()&lt;br&gt;internal: renew() [activeSub.end &gt; now] / INSERT DÒNG&lt;br&gt;StoreSubscription MỚI ở [isUpcoming] (không đổi dòng này!)&lt;/font&gt;" vertex="1">
          <mxGeometry height="134" width="310" x="475" y="353" as="geometry" />
        </mxCell>
        <mxCell id="s_expired" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;EXPIRED&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;&lt;font style=&#39;font-size:9.5px;color:#222222&#39;&gt;entry / status = &#39;EXPIRED&#39;;&lt;br&gt;Outbox STORE_SUBSCRIPTION_EXPIRED&lt;/font&gt;" vertex="1">
          <mxGeometry height="96" width="270" x="945" y="372" as="geometry" />
        </mxCell>
        <mxCell id="s_end" parent="1" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry height="28" width="28" x="1066" y="576" as="geometry" />
        </mxCell>
        <mxCell id="n_st01_rule" parent="1" style="rounded=1;arcSize=8;dashed=1;dashPattern=5 3;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#666666;strokeWidth=1.2;fontColor=#111111;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;Lưu ý mô hình hóa UML (1 bản ghi StoreSubscription):&lt;/b&gt;&lt;br&gt;• Khi chủ Store mua nối tiếp / gia hạn lúc đang có gói ACTIVE, giao dịch &lt;b&gt;subscribe()&lt;/b&gt; hoặc &lt;b&gt;settleChargeAtomicTx()&lt;/b&gt; giữ nguyên bản ghi hiệu lực hiện tại và &lt;b&gt;INSERT một bản ghi mới&lt;/b&gt; với &lt;i&gt;start_date = activeSub.end_date&lt;/i&gt;.&lt;br&gt;• Dòng mới đó bắt đầu từ nút Khởi tạo của chính nó (vào trạng thái Queued)." vertex="1">
          <mxGeometry height="92" width="560" x="76" y="540" as="geometry" />
        </mxCell>
        <mxCell id="page_st01_store_subscription_t1" edge="1" parent="1" source="s_init" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.3;endArrow=open;endFill=0;fontColor=#000000;fontSize=9.5;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" target="c_start" value="subscribe() | renew-charge&lt;br&gt;[BillingCharge=PAID]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page_st01_store_subscription_t2" edge="1" parent="1" source="c_start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.3;endArrow=open;endFill=0;fontColor=#000000;fontSize=9.5;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;exitX=0.5;exitY=0;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="s_upcoming" value="[activeSub.end_date &gt; now]">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="340" y="210" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="page_st01_store_subscription_t3" edge="1" parent="1" source="c_start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.3;endArrow=open;endFill=0;fontColor=#000000;fontSize=9.5;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;exitX=0.5;exitY=1;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="s_effective" value="[no active sub / start &lt;= now]">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="340" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="page_st01_store_subscription_t4" edge="1" parent="1" source="s_upcoming" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.3;endArrow=open;endFill=0;fontColor=#000000;fontSize=9.5;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" target="s_effective" value="when(now &gt;= startDate) [cùng bản ghi chuyển sang hiệu lực]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page_st01_store_subscription_t5" edge="1" parent="1" source="s_effective" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.3;endArrow=open;endFill=0;fontColor=#000000;fontSize=9.5;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="s_expired" value="@Cron(&#39;*/10 * * * *&#39;) [end_date &lt;= now] /&lt;br&gt;processExpiredStoreSubscriptions()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page_st01_store_subscription_t6" edge="1" parent="1" source="s_expired" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.3;endArrow=open;endFill=0;fontColor=#000000;fontSize=9.5;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" target="s_end" value="lifecycle closed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
