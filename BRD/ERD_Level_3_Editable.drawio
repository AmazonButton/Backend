        <mxCell id="page_seq_06_admin_rbac_lock_msg_53" value="8. SQL: BEGIN; SELECT user_id,&lt;br/&gt;tokens_invalid_before FROM users&lt;br/&gt;WHERE user_id=$1 FOR UPDATE;&lt;br/&gt;UPDATE users SET status=$2,&lt;br/&gt;tokens_invalid_before=GREATEST(&lt;br/&gt;COALESCE(tokens_invalid_before,&lt;br/&gt;to_timestamp(0)),$3);&lt;br/&gt;opt (nextStatus!=&#39;ACTIVE&#39;) UPDATE&lt;br/&gt;refresh_tokens SET is_revoked=true&lt;br/&gt;WHERE user_id=$1; COMMIT" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.3;html=1;fontSize=9.5;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center;" edge="1" parent="1">
