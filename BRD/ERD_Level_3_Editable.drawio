              <mxPoint x="90" y="355" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="tr_iot_9" edge="1" parent="1" source="st_inactive" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" target="st_maintenance" value="reportDefect [hardware failure] / moveToMaintenance">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr_iot_10" edge="1" parent="1" source="st_maintenance" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" target="st_unassigned" value="recertify [repair successful] / returnToInventory">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr_iot_11" edge="1" parent="1" source="st_maintenance" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" target="st_decommissioned" value="retireDevice [irreparable || end of life] / decommission">
