        <mxCell id="lane_a4_service" parent="pool_a4" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=11;collapsible=0;" value="Backend Wallet Service &amp; DB" vertex="1">
          <mxGeometry x="720" y="30" width="360" height="1070" as="geometry" />
        </mxCell>
        <mxCell id="lane_a4_payos" parent="pool_a4" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=11;collapsible=0;" value="PayOS Payout Gateway" vertex="1">
          <mxGeometry x="1080" y="30" width="360" height="1070" as="geometry" />
        </mxCell>
        <!-- lane_a4_owner -->
        <mxCell id="a4_init" parent="lane_a4_owner" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry x="166" y="50" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="a4_act_request" parent="lane_a4_owner" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Request Withdrawal&lt;/b&gt;&lt;br&gt;Specify amount &amp; verify auth token;&lt;br&gt;Must have verified bank account." vertex="1">
          <mxGeometry x="65" y="110" width="230" height="75" as="geometry" />
        </mxCell>
        <!-- lane_a4_service (reserve) -->
        <mxCell id="a4_act_reserve" parent="lane_a4_service" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Pessimistic Lock &amp; Reserve&lt;/b&gt;&lt;br&gt;SELECT ... FOR UPDATE on wallet;&lt;br&gt;Check balance &gt;= amount;&lt;br&gt;balance -= amount; frozen += amount;&lt;br&gt;Snapshot immutable bank details." vertex="1">
          <mxGeometry x="65" y="110" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a4_act_cas_claim" parent="lane_a4_service" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;CAS Claim Withdrawal&lt;/b&gt;&lt;br&gt;UPDATE status = PROCESSING&lt;br&gt;WHERE id = :id AND status = PENDING;&lt;br&gt;Prevent concurrent dispatch." vertex="1">
          <mxGeometry x="65" y="360" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a4_act_unfreeze" parent="lane_a4_service" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Atomic Unfreeze Balance&lt;/b&gt;&lt;br&gt;frozen -= amount; balance += amount;&lt;br&gt;Status = REJECTED / FAILED." vertex="1">
          <mxGeometry x="65" y="240" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a4_act_deduct_final" parent="lane_a4_service" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Deduct Frozen Balance&lt;/b&gt;&lt;br&gt;frozen -= amount;&lt;br&gt;Status = SUCCEEDED;&lt;br&gt;Write ledger &amp; invalidate cache." vertex="1">
          <mxGeometry x="65" y="780" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a4_act_hold_recon" parent="lane_a4_service" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Retain Frozen &amp; Reconcile&lt;/b&gt;&lt;br&gt;Status = PENDING_RECONCILIATION;&lt;br&gt;Keep funds safe, poll API via reference." vertex="1">
          <mxGeometry x="65" y="640" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a4_fin_success" parent="lane_a4_service" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry x="166" y="900" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="a4_fin_fail" parent="lane_a4_service" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry x="166" y="980" width="28" height="28" as="geometry" />
        </mxCell>
        <!-- lane_a4_admin -->
        <mxCell id="a4_dec_admin" parent="lane_a4_admin" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;align=center;" value="Admin Approves?" vertex="1">
          <mxGeometry x="120" y="240" width="120" height="75" as="geometry" />
        </mxCell>
        <!-- lane_a4_payos -->
        <mxCell id="a4_act_call_payos" parent="lane_a4_payos" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Call PayOS Payout API&lt;/b&gt;&lt;br&gt;POST /v1/payouts-account/payouts;&lt;br&gt;Send unique reference &amp; recipient." vertex="1">
          <mxGeometry x="65" y="360" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a4_dec_provider" parent="lane_a4_payos" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;align=center;" value="Provider Response?" vertex="1">
          <mxGeometry x="110" y="500" width="140" height="85" as="geometry" />
        </mxCell>
        <!-- Edges -->
        <mxCell id="a4_e0" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" source="a4_init" target="a4_act_request" value="">
