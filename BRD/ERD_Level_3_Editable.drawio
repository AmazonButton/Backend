        <mxCell id="page_st11_store_lifecycle_t5" edge="1" parent="1" source="s_act" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.3;endArrow=open;endFill=0;fontColor=#000000;fontSize=9.5;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;exitX=0.72;exitY=0;entryX=0.72;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="s_inact" value="PATCH /admin/stores/:id {INACTIVE}">
