  <diagram id="page_st_sup2a_store_cash_voucher" name="[ST-SUP2A] StoreCashVoucher State">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1260" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="page_st_sup2a_store_cash_voucher_note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11.5;fontColor=#000000;fillColor=#F8F9FA;strokeColor=#000000;strokeWidth=1.2;" value="&lt;b&gt;ST-SUP2A — Vòng đời Phiếu Thu Tiền mặt Tại Quầy (StoreCashVoucher)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;color:#333333&#39;&gt;Tách khỏi ST-SUP2 cũ | Ràng buộc SQL ck_cash_voucher_state (&#39;ACTIVE&#39;, &#39;CONSUMED&#39;, &#39;REVOKED&#39;) + uq_cash_voucher_active_rental (tối đa 1 ACTIVE / rental)&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="1160" x="50" y="18" as="geometry" />
        </mxCell>
        <mxCell id="v_init" parent="1" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry height="24" width="24" x="148" y="248" as="geometry" />
        </mxCell>
        <mxCell id="v_act" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;ACTIVE [TTL 120 phút]&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;&lt;font style=&#39;font-size:9.5px;color:#222222&#39;&gt;POST /rentals/:id/cash-vouchers [CUSTOMER];&lt;br&gt;Lưu tokenHash SHA-256; cho phép thu tiền&lt;br&gt;khi status==&#39;ACTIVE&#39; &amp;&amp; expires_at &gt; NOW()&lt;/font&gt;" vertex="1">
          <mxGeometry height="94" width="290" x="355" y="213" as="geometry" />
        </mxCell>
        <mxCell id="v_con" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;CONSUMED&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;&lt;font style=&#39;font-size:9.5px;color:#222222&#39;&gt;StoreCash.collect() [expires_at &gt; NOW()]:&lt;br&gt;trừ StoreWallet -&gt; BillingCharge PAID -&gt; PENDING_HANDOVER&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="290" x="835" y="125" as="geometry" />
        </mxCell>
        <mxCell id="v_rev" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;REVOKED&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;&lt;font style=&#39;font-size:9.5px;color:#222222&#39;&gt;Khách sinh Voucher mới cho cùng Rental&lt;br&gt;(thu hồi voucher ACTIVE cũ trong transaction)&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="290" x="835" y="320" as="geometry" />
        </mxCell>
        <mxCell id="v_end" parent="1" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry height="28" width="28" x="1176" y="251" as="geometry" />
        </mxCell>
        <mxCell id="n_sup2a" parent="1" style="rounded=1;arcSize=8;dashed=1;dashPattern=5 3;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#666666;strokeWidth=1.2;fontColor=#111111;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;Ghi chú về Hết hạn (Expiration Guard):&lt;/b&gt;&lt;br&gt;• SQL constraint &lt;code&gt;ck_cash_voucher_state&lt;/code&gt; chỉ định nghĩa 3 trạng thái lưu DB: &lt;code&gt;ACTIVE&lt;/code&gt; (&lt;code&gt;consumed_at IS NULL AND revoked_at IS NULL&lt;/code&gt;), &lt;code&gt;CONSUMED&lt;/code&gt; và &lt;code&gt;REVOKED&lt;/code&gt;.&lt;br&gt;• Thời hạn 120 phút được đánh giá động qua điều kiện &lt;code&gt;expires_at &amp;gt; clock_timestamp()&lt;/code&gt; tại &lt;i&gt;StoreCash.collect()&lt;/i&gt; (trả 410 nếu đã quá hạn)." vertex="1">
          <mxGeometry height="104" width="1020" x="120" y="460" as="geometry" />
        </mxCell>
        <mxCell id="page_st_sup2a_store_cash_voucher_t1" edge="1" parent="1" source="v_init" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.3;endArrow=open;endFill=0;fontColor=#000000;fontSize=9.5;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" target="v_act" value="issueVoucher()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page_st_sup2a_store_cash_voucher_t2" edge="1" parent="1" source="v_act" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.3;endArrow=open;endFill=0;fontColor=#000000;fontSize=9.5;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;exitX=1;exitY=0.28;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="v_con" value="collect() [expires_at &gt; now()]">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="239" />
              <mxPoint x="750" y="170" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="page_st_sup2a_store_cash_voucher_t3" edge="1" parent="1" source="v_act" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.3;endArrow=open;endFill=0;fontColor=#000000;fontSize=9.5;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;exitX=1;exitY=0.72;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="v_rev" value="issueNewVoucherForSameRental()">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="281" />
              <mxPoint x="750" y="360" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="page_st_sup2a_store_cash_voucher_t4" edge="1" parent="1" source="v_con" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.3;endArrow=open;endFill=0;fontColor=#000000;fontSize=9.5;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;exitX=1;exitY=0.5;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="v_end" value="consumed">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1190" y="170" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="page_st_sup2a_store_cash_voucher_t5" edge="1" parent="1" source="v_rev" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.3;endArrow=open;endFill=0;fontColor=#000000;fontSize=9.5;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;exitX=1;exitY=0.5;entryX=0.5;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="v_end" value="revoked">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1190" y="360" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_st_sup2b_rental_return" name="[ST-SUP2B] RentalReturn State">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1260" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="page_st_sup2b_rental_return_note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11.5;fontColor=#000000;fillColor=#F8F9FA;strokeColor=#000000;strokeWidth=1.2;" value="&lt;b&gt;ST-SUP2B — Vòng đời Phiếu Trả Thiết bị Thuê (RentalReturn)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;color:#333333&#39;&gt;Tách khỏi ST-SUP2 cũ | Tác động đồng thời lên IoTButton (RETURN_IN_TRANSIT -&gt; ALLOCATED_TO_STORE/INACTIVE), ButtonRental &amp; DepositRefund (PENDING_APPROVAL)&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="1160" x="50" y="18" as="geometry" />
        </mxCell>
        <mxCell id="rr_init" parent="1" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry height="24" width="24" x="148" y="248" as="geometry" />
        </mxCell>
        <mxCell id="rr_pend" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;PENDING_RECEIPT&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;&lt;font style=&#39;font-size:9.5px;color:#222222&#39;&gt;POST /rentals/:id/return-requests [CUSTOMER]:&lt;br&gt;Button -&gt; RETURN_IN_TRANSIT (canOrder=false);&lt;br&gt;Outbox RENTAL_RETURN_REQUESTED&lt;/font&gt;" vertex="1">
          <mxGeometry height="94" width="310" x="345" y="213" as="geometry" />
        </mxCell>
        <mxCell id="rr_recv" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;RECEIVED&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;&lt;font style=&#39;font-size:9.5px;color:#222222&#39;&gt;POST /rentals/returns/:returnId/confirm-receipt&lt;br&gt;[STORE_OWNER đúng kho hoặc SYSTEM_STAFF/ADMIN/SUPER_ADMIN]:&lt;br&gt;Button -&gt; ALLOCATED_TO_STORE/INACTIVE;&lt;br&gt;tạo DepositRefund(&#39;PENDING_APPROVAL&#39;); rental -&gt; RETURNED&lt;/font&gt;" vertex="1">
          <mxGeometry height="108" width="320" x="780" y="206" as="geometry" />
        </mxCell>
        <mxCell id="rr_end" parent="1" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry height="28" width="28" x="1166" y="246" as="geometry" />
        </mxCell>
        <mxCell id="n_sup2b" parent="1" style="rounded=1;arcSize=8;dashed=1;dashPattern=5 3;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#666666;strokeWidth=1.2;fontColor=#111111;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;Phân quyền Xác nhận Trả Nút (confirmReturnReceiptTx):&lt;/b&gt;&lt;br&gt;• Cho phép &lt;code&gt;STORE_OWNER&lt;/code&gt; (nút thuộc &lt;i&gt;fulfillmentStoreId&lt;/i&gt; của mình) và &lt;code&gt;SYSTEM_STAFF | ADMIN | SYSTEM_ADMIN | SUPER_ADMIN&lt;/code&gt;.&lt;br&gt;• Lưu ý: Giao dịch chỉ khởi tạo bản ghi đề nghị hoàn cọc &lt;code&gt;DepositRefund (&#39;PENDING_APPROVAL&#39;)&lt;/code&gt; (không tự trừ tiền cọc cho đến khi Admin phê duyệt ở &lt;i&gt;ST09/ACT13&lt;/i&gt;)." vertex="1">
          <mxGeometry height="96" width="1020" x="120" y="430" as="geometry" />
        </mxCell>
        <mxCell id="page_st_sup2b_rental_return_t1" edge="1" parent="1" source="rr_init" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.3;endArrow=open;endFill=0;fontColor=#000000;fontSize=9.5;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" target="rr_pend" value="createReturnRequestTx()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page_st_sup2b_rental_return_t2" edge="1" parent="1" source="rr_pend" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.3;endArrow=open;endFill=0;fontColor=#000000;fontSize=9.5;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" target="rr_recv" value="confirmReturnReceiptTx()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page_st_sup2b_rental_return_t3" edge="1" parent="1" source="rr_recv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.3;endArrow=open;endFill=0;fontColor=#000000;fontSize=9.5;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" target="rr_end" value="return settled">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_st_sup3_bank_refund_obligations" name="[ST-SUP3] Bank Refund Obligations">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1540" pageHeight="940" math="0" shadow="0">
      <root>
