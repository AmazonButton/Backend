        <mxCell id="pool_pay" parent="1" style="swimlane;startSize=30;horizontal=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14;" value="Payment lifecycle — distinguish local PaymentTransaction from provider link states" vertex="1">
          <mxGeometry height="1250" width="1520" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="v_lane_pay_user" parent="pool_pay" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;collapsible=0;" value="Payer (Khách hàng / Chủ quán)" vertex="1">
          <mxGeometry height="1220" width="380" y="30" as="geometry" />
        </mxCell>
        <mxCell id="pay_init" parent="v_lane_pay_user" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry height="28" width="28" x="176" y="55" as="geometry" />
        </mxCell>
        <mxCell id="st_pay_pending" parent="v_lane_pay_user" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;PENDING&lt;/b&gt;&lt;hr size=&quot;1&quot; style=&quot;margin: 3px 0;&quot;/&gt;&lt;div style=&quot;font-size: 10px; text-align: left;&quot;&gt;entry / Generate dynamic PayOS VietQR &amp;amp; checkout URL&lt;br/&gt;do / Await banking payment&lt;br/&gt;exit / Close checkout link on settlement&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="230" x="80" y="115" as="geometry" />
        </mxCell>
        <mxCell id="st_pay_cancelled" parent="v_lane_pay_user" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;CANCELLED&lt;/b&gt;&lt;hr size=&quot;1&quot; style=&quot;margin: 3px 0;&quot;/&gt;&lt;div style=&quot;font-size: 10px; text-align: left;&quot;&gt;entry / Payer clicks cancel checkout&lt;br/&gt;do / Mark transaction cancelled&lt;br/&gt;status / Terminal state&lt;/div&gt;" vertex="1">
          <mxGeometry height="75" width="220" x="80" y="245" as="geometry" />
        </mxCell>
        <mxCell id="pay_final_cancelled" parent="v_lane_pay_user" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry height="28" width="28" x="176" y="345" as="geometry" />
        </mxCell>
        <mxCell id="v_lane_pay_payos" parent="pool_pay" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;collapsible=0;" value="PayOS Checkout &amp;amp; Bank Gateway (Cổng thanh toán)" vertex="1">
          <mxGeometry height="1220" width="380" x="380" y="30" as="geometry" />
        </mxCell>
        <mxCell id="st_pay_failed" parent="v_lane_pay_payos" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;Provider failure / unresolved result&lt;/b&gt;&lt;br&gt;Transport error is not financial failure.&lt;br&gt;Reconcile before terminal local change." vertex="1">
          <mxGeometry height="75" width="220" x="80" y="445" as="geometry" />
        </mxCell>
        <mxCell id="pay_final_failed" parent="v_lane_pay_payos" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry height="28" width="28" x="176" y="555" as="geometry" />
        </mxCell>
        <mxCell id="v_lane_pay_backend" parent="pool_pay" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;collapsible=0;" value="Backend Webhook &amp;amp; Idempotency Engine" vertex="1">
          <mxGeometry height="1220" width="380" x="760" y="30" as="geometry" />
        </mxCell>
        <mxCell id="st_pay_paid" parent="v_lane_pay_backend" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;PAID&lt;/b&gt;&lt;br&gt;Authenticated webhook, bound amount/reference.&lt;br&gt;Idempotent transaction; rental waits for handover." vertex="1">
          <mxGeometry height="80" width="230" x="80" y="445" as="geometry" />
