        <mxCell id="s7_note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;fontColor=#333333;fillColor=#F8F9FA;strokeColor=#D5D5D5;strokeWidth=1;spacing=8;" value="&lt;b&gt;State Machine: Customer Bank 2.000đ Verification &amp; Refund&lt;/b&gt;&lt;br&gt;Tách biệt 4 thực thể: Proof (phiên xác minh), Inbound (giao dịch nhận tiền), Obligation (nghĩa vụ hoàn cọc), Payout Attempt (lần chi trả PayOS)." vertex="1">
          <mxGeometry x="40" y="20" width="1520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s7_init" parent="1" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry x="216" y="160" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s7_st_acc_pending" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Account PENDING&lt;/b&gt;&lt;br&gt;AES-256-GCM + deterministic SHA-256;&lt;br&gt;Masked display (******1234);&lt;br&gt;is_verified = false." vertex="1">
          <mxGeometry x="115" y="220" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s7_st_proof_active" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Proof Session ACTIVE&lt;/b&gt;&lt;br&gt;Stable orderCode + checkout URL;&lt;br&gt;VietQR 2.000đ with unique transfer code." vertex="1">
          <mxGeometry x="115" y="350" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s7_st_acc_verified" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Account VERIFIED&lt;/b&gt;&lt;br&gt;CAS consume proof session;&lt;br&gt;is_verified = true;&lt;br&gt;Ready for deposit refund destination." vertex="1">
          <mxGeometry x="115" y="630" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s7_fin_acc" parent="1" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry x="216" y="750" width="28" height="28" as="geometry" />
