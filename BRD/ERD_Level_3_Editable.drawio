        <mxCell id="page_st06_customer_bank_verify_note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11.5;fontColor=#000000;fillColor=#F8F9FA;strokeColor=#000000;strokeWidth=1.2;" value="&lt;b&gt;ST06 — Vòng đời Phiên Chứng minh 2.000đ &amp; Tài khoản Ngân hàng Khách (Hai Máy Độc lập)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;color:#333333&#39;&gt;Loại bỏ Fork/Join gộp kết thúc chung | Phiên Chứng minh (Proof) hết hạn hoặc tiêu dùng không kết thúc tuổi đời tài khoản ngân hàng (CustomerBankAccount)&lt;/font&gt;" vertex="1">
