        <mxCell id="v_lane_kyc_didit" parent="pool_kyc" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;collapsible=0;" value="Didit eKYC Engine (AI nhận diện sinh trắc học)" vertex="1">
          <mxGeometry height="1220" width="380" x="380" y="30" as="geometry" />
        </mxCell>
        <mxCell id="st_kyc_expired" parent="v_lane_kyc_didit" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;EXPIRED&lt;/b&gt;&lt;br&gt;Provider session expiry/status.&lt;br&gt;No hard-coded 30-minute guarantee." vertex="1">
          <mxGeometry height="75" width="220" x="80" y="245" as="geometry" />
        </mxCell>
        <mxCell id="kyc_final_expired" parent="v_lane_kyc_didit" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry height="28" width="28" x="176" y="345" as="geometry" />
        </mxCell>
        <mxCell id="st_kyc_in_review" parent="v_lane_kyc_didit" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;IN_REVIEW&lt;/b&gt;&lt;hr size=&quot;1&quot; style=&quot;margin: 3px 0;&quot;/&gt;&lt;div style=&quot;font-size: 10px; text-align: left;&quot;&gt;entry / Media uploaded to Didit cloud&lt;br/&gt;do / AI biometric matching &amp;amp; OCR validation&lt;br/&gt;exit / Generate verification score &amp;amp; decision&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="230" x="80" y="415" as="geometry" />
        </mxCell>
        <mxCell id="v_lane_kyc_backend" parent="pool_kyc" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;collapsible=0;" value="Backend Auth &amp;amp; KYC Service (Xử lý Webhook &amp;amp; DB)" vertex="1">
          <mxGeometry height="1220" width="380" x="760" y="30" as="geometry" />
        </mxCell>
        <mxCell id="st_kyc_approved" parent="v_lane_kyc_backend" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;APPROVED&lt;/b&gt;&lt;br&gt;Verified provider decision.&lt;br&gt;users.kyc_status = APPROVED; not blanket RBAC access." vertex="1">
          <mxGeometry height="80" width="230" x="80" y="575" as="geometry" />
        </mxCell>
        <mxCell id="kyc_final_approved" parent="v_lane_kyc_backend" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry height="28" width="28" x="176" y="685" as="geometry" />
        </mxCell>
        <mxCell id="st_kyc_declined" parent="v_lane_kyc_backend" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;DECLINED&lt;/b&gt;&lt;br&gt;Provider decline; preserve existing approved verification.&lt;br&gt;No fixed biometric threshold assumed." vertex="1">
          <mxGeometry height="80" width="230" x="80" y="755" as="geometry" />
        </mxCell>
        <mxCell id="kyc_final_declined" parent="v_lane_kyc_backend" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry height="28" width="28" x="176" y="865" as="geometry" />
        </mxCell>
        <mxCell id="v_lane_kyc_admin" parent="pool_kyc" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;collapsible=0;" value="Admin / Compliance Officer (Kiểm duyệt &amp;amp; Tra soát)" vertex="1">
          <mxGeometry height="1220" width="380" x="1140" y="30" as="geometry" />
        </mxCell>
        <mxCell id="tr_kyc_1" edge="1" parent="1" source="kyc_init" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" target="st_kyc_pending" value="initiateSession / createDiditToken">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr_kyc_2" edge="1" parent="1" source="st_kyc_pending" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" target="st_kyc_abandoned" value="cancelSession [user exits] / logAbandon">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr_kyc_3" edge="1" parent="1" source="st_kyc_abandoned" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" target="kyc_final_abandoned" value="terminate">
