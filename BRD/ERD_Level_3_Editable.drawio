        <mxCell id="page_st_sup4_user_platform_membership_t4" edge="1" parent="1" source="c_u" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.3;endArrow=open;endFill=0;fontColor=#000000;fontSize=9.5;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" target="u_act" value="[register() mặc định ACTIVE]">
