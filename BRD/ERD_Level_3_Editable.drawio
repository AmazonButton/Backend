          <mxGeometry x="40" y="80" width="1200" height="880" as="geometry" />
        </mxCell>
        <mxCell id="lane_s6_driver" parent="pool_s6" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=11;collapsible=0;" value="Delivery Driver (Tài xế giao hàng)" vertex="1">
          <mxGeometry x="0" y="30" width="400" height="850" as="geometry" />
        </mxCell>
        <mxCell id="lane_s6_manager" parent="pool_s6" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=11;collapsible=0;" value="Store Shift Manager (Quản lý cửa hàng)" vertex="1">
          <mxGeometry x="400" y="30" width="400" height="850" as="geometry" />
        </mxCell>
        <mxCell id="lane_s6_system" parent="pool_s6" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=11;collapsible=0;" value="Shift Service &amp; Driver Duty Engine" vertex="1">
          <mxGeometry x="800" y="30" width="400" height="850" as="geometry" />
        </mxCell>
        <!-- Driver Lane -->
        <mxCell id="s6_init" parent="lane_s6_driver" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry x="186" y="50" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s6_st_open" parent="lane_s6_driver" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;OPEN&lt;/b&gt;&lt;br&gt;Driver startShift; idempotent;&lt;br&gt;Exactly one open shift per driver;&lt;br&gt;Eligible for order assignments." vertex="1">
          <mxGeometry x="85" y="110" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s6_st_closed" parent="lane_s6_driver" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;CLOSED&lt;/b&gt;&lt;br&gt;Driver closeShift;&lt;br&gt;Snapshot delivered count &amp; COD total;&lt;br&gt;Pending physical handover." vertex="1">
          <mxGeometry x="85" y="270" width="230" height="80" as="geometry" />
        </mxCell>
        <!-- Manager Lane -->
        <mxCell id="s6_st_handed" parent="lane_s6_manager" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;HANDED_OVER&lt;/b&gt;&lt;br&gt;Authorized store confirmer confirms;&lt;br&gt;Cash COD verified &amp; settled;&lt;br&gt;Store audit log persisted." vertex="1">
          <mxGeometry x="85" y="270" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s6_fin_shift" parent="lane_s6_manager" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry x="186" y="390" width="28" height="28" as="geometry" />
        </mxCell>
        <!-- System Lane (Duty state independent) -->
        <mxCell id="s6_st_duty_online" parent="lane_s6_system" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;DriverDuty.ONLINE&lt;/b&gt;&lt;br&gt;Driver app sends heartbeat;&lt;br&gt;Dispatch engine maps active orders.&lt;br&gt;(Independent from Shift status)" vertex="1">
          <mxGeometry x="85" y="520" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s6_st_duty_offline" parent="lane_s6_system" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;DriverDuty.OFFLINE&lt;/b&gt;&lt;br&gt;Driver toggles offline / app closed;&lt;br&gt;Excluded from dispatch pool." vertex="1">
          <mxGeometry x="85" y="680" width="230" height="80" as="geometry" />
        </mxCell>
        <!-- Edges -->
        <mxCell id="s6_e0" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" source="s6_init" target="s6_st_open" value="Driver clicks Start Shift">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s6_e1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" source="s6_st_open" target="s6_st_closed" value="Driver Closes Shift">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s6_e2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" source="s6_st_closed" target="s6_st_handed" value="Manager verifies COD">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s6_e3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" source="s6_st_open" target="s6_st_handed" value="Direct Manager Confirmation">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="450" y="210" />
              <mxPoint x="450" y="290" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="s6_e4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" source="s6_st_handed" target="s6_fin_shift" value="Shift completed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s6_e5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" source="s6_st_duty_online" target="s6_st_duty_offline" value="Toggle Offline / Heartbeat Timeout">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="880" y="640" />
              <mxPoint x="880" y="660" />
            </Array>
          </mxGeometry>
