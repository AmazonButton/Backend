        <mxCell id="s6_st_open" parent="lane_s6_driver" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;OPEN&lt;/b&gt;&lt;br&gt;Driver startShift; idempotent;&lt;br&gt;Exactly one open shift per driver;&lt;br&gt;Eligible for order assignments." vertex="1">
