        <mxCell id="s7_st_webhook_inbound" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Inbound Webhook Received&lt;/b&gt;&lt;br&gt;Verify timing-safe HMAC raw body;&lt;br&gt;Extract source bank bin &amp; account." vertex="1">
          <mxGeometry x="495" y="350" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s7_st_obs_unconfirmed" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Inbound Observation Only&lt;/b&gt;&lt;br&gt;Missing provider reference;&lt;br&gt;Preserve audit payload;&lt;br&gt;DO NOT create refund obligation." vertex="1">
          <mxGeometry x="495" y="480" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s7_st_inbound_confirmed" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Confirmed Inbound Transaction&lt;/b&gt;&lt;br&gt;UNIQUE(provider, channel, reference);&lt;br&gt;Atomic creation with Refund Obligation;&lt;br&gt;Actual received amount recorded." vertex="1">
          <mxGeometry x="495" y="630" width="230" height="85" as="geometry" />
        </mxCell>
        <mxCell id="s7_st_proof_expired" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Proof EXPIRED / REJECTED&lt;/b&gt;&lt;br&gt;Session timeout or name mismatch;&lt;br&gt;Late inbound still accounted for refund." vertex="1">
          <mxGeometry x="875" y="480" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s7_st_manual_refund" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;PENDING_MANUAL_REFUND&lt;/b&gt;&lt;br&gt;Missing source account evidence;&lt;br&gt;Flag for compliance inspection;&lt;br&gt;No automated payout attempted." vertex="1">
          <mxGeometry x="875" y="780" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s7_st_obligation_created" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Obligation CREATED&lt;/b&gt;&lt;br&gt;Target amount: actual inbound amount;&lt;br&gt;Auto refund claimed by Cron Worker." vertex="1">
          <mxGeometry x="1255" y="630" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s7_st_attempt_processing" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Payout Attempt PROCESSING&lt;/b&gt;&lt;br&gt;Dispatch automated PayOS Payout;&lt;br&gt;Immutable destination snapshot." vertex="1">
