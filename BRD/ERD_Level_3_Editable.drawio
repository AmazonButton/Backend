          <mxGeometry height="80" width="220" x="80" y="545" as="geometry" />
        </mxCell>
        <mxCell id="st_decommissioned" parent="v_lane_iot_cloud" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;Retirement (proposed hardware process)&lt;/b&gt;&lt;br&gt;Not a verified automatic credential-deletion flow." vertex="1">
          <mxGeometry height="80" width="220" x="80" y="965" as="geometry" />
        </mxCell>
        <mxCell id="iot_final" parent="v_lane_iot_cloud" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry height="28" width="28" x="176" y="1085" as="geometry" />
        </mxCell>
        <mxCell id="tr_iot_1" edge="1" parent="1" source="iot_init" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" target="st_unassigned" value="registerDevice / assignHmacCredentials">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr_iot_2" edge="1" parent="1" source="st_unassigned" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" target="st_provisioning" value="dispatchDevice / createPairingToken">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr_iot_3" edge="1" parent="1" source="st_provisioning" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" target="st_active" value="confirmPairing [valid signature &amp;&amp; token] / bindCustomer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr_iot_4" edge="1" parent="1" source="st_provisioning" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" target="st_unassigned" value="timeoutSession [now &gt;= expiresAt] / expireSession">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr_iot_5" edge="1" parent="1" source="st_active" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" target="st_suspended" value="rejectReplay [nonce already used] / logAlert">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr_iot_6" edge="1" parent="1" source="st_suspended" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" target="st_active" value="receiveEvent [valid signature &amp;&amp; nonce] / processClick">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr_iot_7" edge="1" parent="1" source="st_active" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" target="st_inactive" value="deactivateDevice [rental expired || unbind] / disableOrders">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr_iot_8" edge="1" parent="1" source="st_inactive" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" target="st_provisioning" value="reassignCustomer / createNewPairing">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
