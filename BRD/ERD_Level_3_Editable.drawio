        </mxCell>
        <mxCell id="s6_st_duty_online" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;DepositRefund.APPROVED&lt;/b&gt;&lt;br&gt;ADMIN / SUPER_ADMIN approves refund;&lt;br&gt;Settles rental_deposits ledger once." vertex="1">
          <mxGeometry x="925" y="630" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s6_st_duty_offline" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;REJECTED&lt;/b&gt;&lt;br&gt;Invalid warranty claim or auto-closed duplicate;&lt;br&gt;No hardware swap or refund." vertex="1">
