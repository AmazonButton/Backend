  <diagram id="page_store_withdrawal_lifecycle" name="[STATE 3] Store Withdrawal">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1520" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s3_note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;fontColor=#333333;fillColor=#F8F9FA;strokeColor=#D5D5D5;strokeWidth=1;spacing=8;" value="&lt;b&gt;State Machine: Store Withdrawal Lifecycle&lt;/b&gt;&lt;br&gt;Tuân thủ kiến trúc CAS (Compare-And-Swap) và Payout tự động PayOS. Không chuyển thẳng FAILED/SUCCEEDED khi timeout mà giữ PENDING_RECONCILIATION." vertex="1">
          <mxGeometry x="40" y="20" width="1440" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pool_s3" parent="1" style="swimlane;startSize=30;horizontal=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=13;" value="STATE MACHINE: STORE WALLET WITHDRAWAL LIFECYCLE" vertex="1">
          <mxGeometry x="40" y="80" width="1440" height="960" as="geometry" />
        </mxCell>
        <mxCell id="lane_s3_owner" parent="pool_s3" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=11;collapsible=0;" value="Store Owner (Chủ quán)" vertex="1">
          <mxGeometry x="0" y="30" width="360" height="930" as="geometry" />
        </mxCell>
        <mxCell id="lane_s3_admin" parent="pool_s3" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=11;collapsible=0;" value="Admin Reviewer (Quản trị viên)" vertex="1">
          <mxGeometry x="360" y="30" width="360" height="930" as="geometry" />
        </mxCell>
        <mxCell id="lane_s3_backend" parent="pool_s3" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=11;collapsible=0;" value="Backend Wallet Service &amp; DB" vertex="1">
          <mxGeometry x="720" y="30" width="360" height="930" as="geometry" />
        </mxCell>
        <mxCell id="lane_s3_payos" parent="pool_s3" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=11;collapsible=0;" value="PayOS Payout Gateway" vertex="1">
          <mxGeometry x="1080" y="30" width="360" height="930" as="geometry" />
        </mxCell>
        <!-- Nodes in lane_s3_owner -->
        <mxCell id="s3_init" parent="lane_s3_owner" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry x="166" y="50" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s3_st_pending" parent="lane_s3_owner" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;PENDING&lt;/b&gt;&lt;br&gt;Request withdrawal;&lt;br&gt;Lock wallet &amp; reserve balance;&lt;br&gt;Snapshot encrypted bank details." vertex="1">
          <mxGeometry x="65" y="110" width="230" height="75" as="geometry" />
        </mxCell>
        <!-- Nodes in lane_s3_admin -->
        <mxCell id="s3_st_rejected" parent="lane_s3_admin" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;REJECTED&lt;/b&gt;&lt;br&gt;Authorized reject before dispatch;&lt;br&gt;Unfreeze wallet balance atomically;&lt;br&gt;Audit log persisted." vertex="1">
          <mxGeometry x="65" y="110" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s3_fin_rejected" parent="lane_s3_admin" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry x="166" y="220" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s3_st_recon" parent="lane_s3_admin" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;PENDING_RECONCILIATION&lt;/b&gt;&lt;br&gt;Network timeout / 403 / unknown;&lt;br&gt;Frozen balance retained strictly;&lt;br&gt;Admin manual query / resolve." vertex="1">
          <mxGeometry x="65" y="420" width="230" height="85" as="geometry" />
        </mxCell>
        <!-- Nodes in lane_s3_backend -->
        <mxCell id="s3_st_processing" parent="lane_s3_backend" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;PROCESSING&lt;/b&gt;&lt;br&gt;CAS transition to prevent race;&lt;br&gt;Submit stable payout reference&lt;br&gt;via automated PayOS Payout API." vertex="1">
          <mxGeometry x="65" y="270" width="230" height="75" as="geometry" />
        </mxCell>
