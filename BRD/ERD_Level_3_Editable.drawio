        <mxCell id="tr_kyc_7" edge="1" parent="1" source="st_kyc_in_review" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" target="st_kyc_approved" value="webhookDecision [decision == APPROVED] / grantKYCBadge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr_kyc_8" edge="1" parent="1" source="st_kyc_approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" target="kyc_final_approved" value="finalizeVerification">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr_kyc_9" edge="1" parent="1" source="st_kyc_in_review" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" target="st_kyc_declined" value="webhookDecision [decision == DECLINED] / recordFraudAlert">
          <mxGeometry relative="1" as="geometry" />
