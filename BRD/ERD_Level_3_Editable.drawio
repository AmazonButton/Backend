        </mxCell>
        <mxCell id="page_seq_09_iot_order_msg_54" value="5. SQL: SELECT iot_button + store, customer, rental WHERE device_id=$1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.3;html=1;fontSize=9.5;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center;" edge="1" parent="1">
