        <mxCell id="s6_e1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" source="s6_st_open" target="s6_st_closed" value="SYSTEM_STAFF Approves 1-1 Swap">
