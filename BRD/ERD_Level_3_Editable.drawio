            <mxPoint x="0" y="-8" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="page_seq_09_iot_order_msg_53" value="4. verify timestamp drift ≤&lt;br/&gt;300s" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.3;html=1;fontSize=9.5;fontColor=#000000;labelBackgroundColor=#FFFFFF;align=left;verticalAlign=middle;" edge="1" parent="1">
