        </mxCell>
        <mxCell id="s4_st_pending_payment" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;PENDING_PAYMENT&lt;/b&gt;&lt;br&gt;Create rental + billing charge;&lt;br&gt;Awaiting deposit &amp; rental fee VietQR." vertex="1">
          <mxGeometry height="75" width="230" x="115" y="220" as="geometry" />
