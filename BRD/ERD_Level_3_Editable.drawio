        <mxCell id="page_seq_09_iot_order_msg_50" value="1. Physical button press (SINGLE&lt;br/&gt;/ DOUBLE / LONG)" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.3;html=1;fontSize=9.5;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center;" edge="1" parent="1">
