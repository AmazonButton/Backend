  <diagram id="page_conceptual_diagram" name="[CDM] Conceptual Architecture &amp; Domain Model">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3600" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- DIAGRAM HEADER TITLE &amp; LEGEND BANNER -->
        <mxCell id="cdm_title_banner" parent="1" style="swimlane;startSize=45;horizontal=1;fillColor=#0F172A;strokeColor=#1E293B;strokeWidth=2;fontColor=#F8FAFC;fontStyle=1;fontSize=18;rounded=1;arcSize=4;collapsible=0;" value="SƠ ĐỒ THỰC THỂ KHÁI NIỆM &amp; KIẾN TRÚC HỆ SINH THÁI NÚT BẤM IOT (CONCEPTUAL ARCHITECTURE &amp; DOMAIN MODEL)" vertex="1">
          <mxGeometry x="80" y="40" width="3440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cdm_subtitle" parent="cdm_title_banner" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=0;fontSize=12;fontColor=#94A3B8;" value="Nền tảng Thương mại Điện tử Đa Cửa hàng (Multi-Store Marketplace) &amp; Đặt hàng Nước/Gas Siêu tốc qua Nút bấm ESP32-S3 | Security-by-Design | Zero Plaintext Financials | PayOS VietQR &amp; Payout" vertex="1">
          <mxGeometry x="20" y="48" width="1800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cdm_legend" parent="cdm_title_banner" style="text;html=1;strokeColor=none;fillColor=#1E293B;rounded=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=11;fontColor=#E2E8F0;" value="KÝ HIỆU LIÊN KẾT: ─── (1..1 Một-Một) | ───&lt; (1..* Một-Nhiều) | ... (0..* Tùy chọn) | ──► (Luồng dữ liệu / Sự kiện nghiệp vụ)" vertex="1">
          <mxGeometry x="2500" y="48" width="900" height="30" as="geometry" />
        </mxCell>

        <!-- ==================================================================== -->
        <!-- DOMAIN 1: IAM &amp; MULTI-ROLE IDENTITY (ĐỊNH DANH &amp; PHÂN QUYỀN) -->
        <!-- ==================================================================== -->
