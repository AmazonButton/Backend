        </mxCell>
        <mxCell id="v_lane_iot_hw" parent="pool_iot" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;collapsible=0;" value="IoT Button Hardware (Nút ESP32)" vertex="1">
