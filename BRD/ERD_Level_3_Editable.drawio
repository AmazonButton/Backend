        <mxCell id="page_seq_03_forgot_reset_password_msg_52" value="1. POST /api/v1/auth/forgot-&lt;br/&gt;password(ForgotPasswordDto)" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.3;html=1;fontSize=9.5;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center;" edge="1" parent="1">
