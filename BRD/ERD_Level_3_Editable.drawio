              <mxPoint x="455" y="344" />
            </Array>
            <mxPoint x="8" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="page_seq_09_iot_order_msg_52" value="3. POST /api/v1/iot/events(&lt;br/&gt;headers, IotEventDto)" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.3;html=1;fontSize=9.5;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center;" edge="1" parent="1">
