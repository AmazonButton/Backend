  <diagram id="page_bank_account_lifecycle" name="[STATE 7] Customer Bank Verification &amp; Refund">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s7_note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;fontColor=#333333;fillColor=#F8F9FA;strokeColor=#D5D5D5;strokeWidth=1;spacing=8;" value="&lt;b&gt;State Machine: Customer Bank 2.000đ Verification &amp; Refund&lt;/b&gt;&lt;br&gt;Tách biệt 4 thực thể: Proof (phiên xác minh), Inbound (giao dịch nhận tiền), Obligation (nghĩa vụ hoàn cọc), Payout Attempt (lần chi trả PayOS)." vertex="1">
          <mxGeometry x="40" y="20" width="1520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pool_s7" parent="1" style="swimlane;startSize=30;horizontal=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=13;" value="STATE MACHINE: BANK ACCOUNT 2.000đ VERIFICATION &amp; REFUND" vertex="1">
          <mxGeometry x="40" y="80" width="1520" height="1140" as="geometry" />
        </mxCell>
        <mxCell id="lane_s7_cust" parent="pool_s7" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=11;collapsible=0;" value="Customer / Mobile App" vertex="1">
          <mxGeometry x="0" y="30" width="380" height="1110" as="geometry" />
        </mxCell>
        <mxCell id="lane_s7_payos" parent="pool_s7" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=11;collapsible=0;" value="PayOS VietQR &amp; Webhook Gateway" vertex="1">
          <mxGeometry x="380" y="30" width="380" height="1110" as="geometry" />
        </mxCell>
        <mxCell id="lane_s7_service" parent="pool_s7" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=11;collapsible=0;" value="Bank Verification Service &amp; DB" vertex="1">
          <mxGeometry x="760" y="30" width="380" height="1110" as="geometry" />
        </mxCell>
        <mxCell id="lane_s7_refund" parent="pool_s7" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=11;collapsible=0;" value="Automatic Refund Worker &amp; Payout" vertex="1">
          <mxGeometry x="1140" y="30" width="380" height="1110" as="geometry" />
        </mxCell>
        <!-- lane_s7_cust -->
        <mxCell id="s7_init" parent="lane_s7_cust" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry x="176" y="50" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s7_st_acc_pending" parent="lane_s7_cust" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Account PENDING&lt;/b&gt;&lt;br&gt;AES-256-GCM + deterministic SHA-256;&lt;br&gt;Masked display (******1234);&lt;br&gt;is_verified = false." vertex="1">
          <mxGeometry x="75" y="110" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s7_st_proof_active" parent="lane_s7_cust" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Proof Session ACTIVE&lt;/b&gt;&lt;br&gt;Stable orderCode + checkout URL;&lt;br&gt;VietQR 2.000đ with unique transfer code." vertex="1">
          <mxGeometry x="75" y="240" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s7_st_acc_verified" parent="lane_s7_cust" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Account VERIFIED&lt;/b&gt;&lt;br&gt;CAS consume proof session;&lt;br&gt;is_verified = true;&lt;br&gt;Ready for deposit refund destination." vertex="1">
          <mxGeometry x="75" y="520" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s7_fin_acc" parent="lane_s7_cust" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry x="176" y="640" width="28" height="28" as="geometry" />
        </mxCell>
        <!-- lane_s7_payos -->
        <mxCell id="s7_st_webhook_inbound" parent="lane_s7_payos" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Inbound Webhook Received&lt;/b&gt;&lt;br&gt;Verify timing-safe HMAC raw body;&lt;br&gt;Extract source bank bin &amp; account." vertex="1">
          <mxGeometry x="75" y="240" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s7_st_obs_unconfirmed" parent="lane_s7_payos" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Inbound Observation Only&lt;/b&gt;&lt;br&gt;Missing provider reference;&lt;br&gt;Preserve audit payload;&lt;br&gt;DO NOT create refund obligation." vertex="1">
          <mxGeometry x="75" y="370" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s7_st_inbound_confirmed" parent="lane_s7_payos" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Confirmed Inbound Transaction&lt;/b&gt;&lt;br&gt;UNIQUE(provider, channel, reference);&lt;br&gt;Atomic creation with Refund Obligation;&lt;br&gt;Actual received amount recorded." vertex="1">
          <mxGeometry x="75" y="520" width="230" height="85" as="geometry" />
        </mxCell>
        <!-- lane_s7_service -->
