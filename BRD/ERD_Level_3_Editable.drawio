        <mxCell id="page_seq_08_pairing_config_msg_58" value="9. SQL: BEGIN; UPDATE public.pairing_tokens SET status=&#39;USED&#39; WHERE token_hash=$1 AND device_id=$2&lt;br/&gt;AND status=&#39;ACTIVE&#39; AND expires_at &gt; NOW() RETURNING *; INSERT INTO provisioning_sessions(ACTIVE); COMMIT" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.3;html=1;fontSize=9.5;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center;" edge="1" parent="1">
