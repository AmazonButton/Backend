        <mxCell id="page_st_sup4_user_platform_membership_t5" edge="1" parent="1" source="u_act" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.3;endArrow=open;endFill=0;fontColor=#000000;fontSize=9.5;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;exitX=0.3;exitY=1;entryX=0.23;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" target="u_inact" value="toggleStatus(lock) / khóa TK">
