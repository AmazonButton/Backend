  <diagram id="page_act_button_rental" name="[ACT 5] Button Rental Lifecycle">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="1340" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="a5_note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;fontColor=#333333;fillColor=#F8F9FA;strokeColor=#D5D5D5;strokeWidth=1;spacing=8;" value="&lt;b&gt;Activity: Button Rental Lifecycle Pipeline&lt;/b&gt;&lt;br&gt;Quy trình khép kín: Chọn gói → Thanh toán cọc &amp; phí → Phân bổ cửa hàng → Bàn giao kích hoạt → Quản lý hạn → Thu hồi nút → Hoàn tiền cọc tự động qua PayOS." vertex="1">
          <mxGeometry x="40" y="20" width="1520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pool_a5" parent="1" style="swimlane;startSize=30;horizontal=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=13;" value="ACTIVITY DIAGRAM: PLATFORM IOT BUTTON RENTAL PIPELINE" vertex="1">
          <mxGeometry x="40" y="80" width="1520" height="1240" as="geometry" />
        </mxCell>
        <mxCell id="lane_a5_cust" parent="pool_a5" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=11;collapsible=0;" value="Customer (Khách hàng)" vertex="1">
          <mxGeometry x="0" y="30" width="380" height="1210" as="geometry" />
        </mxCell>
        <mxCell id="lane_a5_store" parent="pool_a5" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=11;collapsible=0;" value="Fulfillment Store Staff (Cửa hàng)" vertex="1">
          <mxGeometry x="380" y="30" width="380" height="1210" as="geometry" />
        </mxCell>
        <mxCell id="lane_a5_engine" parent="pool_a5" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=11;collapsible=0;" value="Rental Engine &amp; Database" vertex="1">
          <mxGeometry x="760" y="30" width="380" height="1210" as="geometry" />
        </mxCell>
        <mxCell id="lane_a5_payos" parent="pool_a5" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=11;collapsible=0;" value="PayOS Gateway &amp; Expiry Cron" vertex="1">
          <mxGeometry x="1140" y="30" width="380" height="1210" as="geometry" />
        </mxCell>
        <!-- lane_a5_cust -->
        <mxCell id="a5_init" parent="lane_a5_cust" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry x="176" y="50" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="a5_act_create" parent="lane_a5_cust" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Select Package &amp; Create Rental&lt;/b&gt;&lt;br&gt;Specify months, delivery address;&lt;br&gt;Server calculates deposit + rental fee." vertex="1">
          <mxGeometry x="75" y="110" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a5_act_pay_qr" parent="lane_a5_cust" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Scan VietQR to Pay&lt;/b&gt;&lt;br&gt;Pay total amount via PayOS checkout link." vertex="1">
          <mxGeometry x="75" y="230" width="230" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a5_act_use" parent="lane_a5_cust" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Customer Uses IoT Button&lt;/b&gt;&lt;br&gt;Press button to order products;&lt;br&gt;Every order checks active rental entitlement." vertex="1">
          <mxGeometry x="75" y="580" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a5_act_req_return" parent="lane_a5_cust" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Request Button Return&lt;/b&gt;&lt;br&gt;Ship buttons back or drop off at store;&lt;br&gt;Status = PENDING_RECEIPT." vertex="1">
          <mxGeometry x="75" y="790" width="230" height="75" as="geometry" />
        </mxCell>
        <!-- lane_a5_store -->
        <mxCell id="a5_act_assign" parent="lane_a5_store" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Assign Store &amp; Physical Buttons&lt;/b&gt;&lt;br&gt;Record DeviceMovements;&lt;br&gt;Button: ALLOCATED_TO_STORE." vertex="1">
