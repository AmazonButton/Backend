        <mxCell id="a4_e1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" source="a4_act_request" target="a4_act_reserve" value="Validate BOLA">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4_e2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" source="a4_act_reserve" target="a4_dec_admin" value="Audit review">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4_e3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" source="a4_dec_admin" target="a4_act_unfreeze" value="[Reject]">
