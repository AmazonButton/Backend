        <mxCell id="bc_pend" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;PENDING&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;&lt;font style=&#39;font-size:9.5px;color:#222222&#39;&gt;Tạo bởi createRental(),&lt;br&gt;createRentalExtensionCharge() hoặc&lt;br&gt;createStoreSubscriptionCharge()&lt;/font&gt;" vertex="1">
          <mxGeometry height="96" width="280" x="350" y="212" as="geometry" />
        </mxCell>
        <mxCell id="bc_paid" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;PAID&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;&lt;font style=&#39;font-size:9.5px;color:#222222&#39;&gt;PayOS settleChargeAtomicTx() /&lt;br&gt;recordRentalPayosReceiptInTx() [khớp VND]&lt;br&gt;HOẶC StoreCash.collect() [STORE_CASH_OFFSET]&lt;/font&gt;" vertex="1">
          <mxGeometry height="108" width="310" x="845" y="126" as="geometry" />
        </mxCell>
        <mxCell id="bc_canc" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;CANCELLED&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;&lt;font style=&#39;font-size:9.5px;color:#222222&#39;&gt;createRental() ghi đè hóa đơn cũ của&lt;br&gt;đơn thuê PENDING_PAYMENT bị bỏ dở&lt;/font&gt;" vertex="1">
          <mxGeometry height="86" width="290" x="855" y="367" as="geometry" />
        </mxCell>
        <mxCell id="bc_end" parent="1" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry height="28" width="28" x="1226" y="281" as="geometry" />
        </mxCell>
        <mxCell id="f_ovp" parent="1" style="swimlane;startSize=28;horizontal=1;rounded=1;arcSize=6;dashed=1;dashPattern=6 4;fillColor=#FAFAFA;strokeColor=#555555;strokeWidth=1.3;fontColor=#000000;fontStyle=1;fontSize=11;html=1;swimlaneFillColor=#FFFFFF;" value="Thực thể liên quan (Tách riêng): BillingOverpaymentObligation (V1 Queue-Only)" vertex="1">
          <mxGeometry height="180" width="920" x="140" y="480" as="geometry" />
        </mxCell>
        <mxCell id="ovp_pend" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;PENDING_RECONCILIATION [V1 Constraint: ck_billing_overpayment_status]&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;&lt;font style=&#39;font-size:9.5px;color:#222222&#39;&gt;Khi recordRentalPayosReceiptInTx() nhận tiền sai số / charge đã PAID / thanh toán qua STORE_CASH_OFFSET:&lt;br&gt;→ Ghi BillingPaymentReceipt(&#39;OVERPAYMENT_RECEIPT&#39;) + BillingOverpaymentObligation(&#39;PENDING_RECONCILIATION&#39;).&lt;br&gt;V1 chỉ có GET /admin/billing-overpayments để tra soát (KHÔNG làm thay đổi BillingCharge, CHƯA có API tự hoàn tiền).&lt;/font&gt;" vertex="1">
