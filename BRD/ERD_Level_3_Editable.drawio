  <diagram id="page_bank_account_lifecycle" name="[STATE 7] Customer Bank Verification &amp; Refund">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="1240" math="0" shadow="0">
