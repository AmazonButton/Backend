        </mxCell>
        <mxCell id="tr_kyc_6" edge="1" parent="1" source="st_kyc_pending" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" target="st_kyc_in_review" value="submitBiometrics / uploadIDAndVideo">
