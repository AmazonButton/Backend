        <mxCell id="s3_e4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" source="s3_st_processing" target="s3_st_payos_exec" value="Dispatch Payout API">
