  <diagram id="page_order_lifecycle" name="[STATE 1] Order Lifecycle">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1800" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pool_order" parent="1" style="swimlane;startSize=30;horizontal=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14;" value="ORDER LIFECYCLE STATE MACHINE (VÒNG ĐỜI ĐƠN HÀNG IOT)" vertex="1">
          <mxGeometry height="1450" width="1520" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="v_lane_ord_cust" parent="pool_order" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;collapsible=0;" value="Customer (Khách hàng)" vertex="1">
          <mxGeometry height="1420" width="380" y="30" as="geometry" />
        </mxCell>
        <mxCell id="ord_init" parent="v_lane_ord_cust" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry height="28" width="28" x="176" y="55" as="geometry" />
        </mxCell>
        <mxCell id="st_pending" parent="v_lane_ord_cust" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;PENDING&lt;/b&gt;&lt;hr size=&quot;1&quot; style=&quot;margin: 3px 0;&quot;/&gt;&lt;div style=&quot;font-size: 10px; text-align: left;&quot;&gt;entry / Lock inventory (SELECT FOR UPDATE)&lt;br/&gt;do / 5-min cancel window active&lt;br/&gt;exit / Cancel-timer terminated&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="220" x="80" y="115" as="geometry" />
        </mxCell>
        <mxCell id="st_cancelled" parent="v_lane_ord_cust" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;CANCELLED&lt;/b&gt;&lt;hr size=&quot;1&quot; style=&quot;margin: 3px 0;&quot;/&gt;&lt;div style=&quot;font-size: 10px; text-align: left;&quot;&gt;entry / Release inventory lock&lt;br/&gt;do / Refund payment if captured&lt;br/&gt;status / Terminal state&lt;/div&gt;" vertex="1">
          <mxGeometry height="75" width="220" x="80" y="245" as="geometry" />
        </mxCell>
        <mxCell id="ord_final_cancelled" parent="v_lane_ord_cust" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry height="28" width="28" x="176" y="345" as="geometry" />
        </mxCell>
        <mxCell id="st_delivered" parent="v_lane_ord_cust" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;DELIVERED&lt;/b&gt;&lt;hr size=&quot;1&quot; style=&quot;margin: 3px 0;&quot;/&gt;&lt;div style=&quot;font-size: 10px; text-align: left;&quot;&gt;entry / Order handed to customer&lt;br/&gt;do / 24h auto-complete timer&lt;br/&gt;exit / Dispute window closes&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="220" x="80" y="1045" as="geometry" />
        </mxCell>
        <mxCell id="v_lane_ord_store" parent="pool_order" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;collapsible=0;" value="Store Staff / Merchant (Cửa hàng / Người bán)" vertex="1">
          <mxGeometry height="1420" width="380" x="380" y="30" as="geometry" />
        </mxCell>
        <mxCell id="st_rejected" parent="v_lane_ord_store" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;REJECTED&lt;/b&gt;&lt;hr size=&quot;1&quot; style=&quot;margin: 3px 0;&quot;/&gt;&lt;div style=&quot;font-size: 10px; text-align: left;&quot;&gt;entry / Merchant rejects (out-of-stock)&lt;br/&gt;do / Release inventory lock; Send alert&lt;br/&gt;status / Terminal state&lt;/div&gt;" vertex="1">
          <mxGeometry height="75" width="220" x="80" y="245" as="geometry" />
        </mxCell>
        <mxCell id="ord_final_rejected" parent="v_lane_ord_store" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry height="28" width="28" x="176" y="345" as="geometry" />
        </mxCell>
        <mxCell id="st_confirmed" parent="v_lane_ord_store" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;CONFIRMED&lt;/b&gt;&lt;hr size=&quot;1&quot; style=&quot;margin: 3px 0;&quot;/&gt;&lt;div style=&quot;font-size: 10px; text-align: left;&quot;&gt;entry / Send kitchen notification&lt;br/&gt;do / Inventory committed&lt;br/&gt;exit / Print prep invoice&lt;/div&gt;" vertex="1">
