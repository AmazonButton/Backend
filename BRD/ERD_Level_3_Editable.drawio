        <mxCell id="tr_kyc_10" edge="1" parent="1" source="st_kyc_declined" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=9;labelBackgroundColor=#FFFFFF;" target="kyc_final_declined" value="terminate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_driver_shift_lifecycle" name="[STATE 6] Driver Shift">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1280" pageHeight="1000" math="0" shadow="0">
