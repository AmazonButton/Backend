        <mxCell id="page_seq_15_store_cash_collection_msg_63" value="22. SQL: BEGIN; LOCK users/store/store_staff FOR SHARE; LOCK store_wallets&lt;br/&gt;FOR UPDATE;&lt;br/&gt;LOCK billing_charges &amp; store_cash_vouchers(tokenHash) FOR UPDATE;&lt;br/&gt;verify wallet.balance ≥ amt; UPDATE store_wallets SET balance -= amt;&lt;br/&gt;INSERT wallet_transactions(RENTAL_CASH_COLLECTION_OFFSET); UPDATE voucher=&lt;br/&gt;&#39;CONSUMED&#39;;&lt;br/&gt;settleInitialRentalInTx(STORE_CASH_OFFSET) → PAID, rental_deposits,&lt;br/&gt;PENDING_HANDOVER;&lt;br/&gt;INSERT store_cash_receipts" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.3;html=1;fontSize=9.5;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center;" edge="1" parent="1">
