        <mxCell id="c_store" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.4;fontColor=#000000;fontSize=9.5;" value="luồng khởi tạo?" vertex="1">
          <mxGeometry height="44" width="44" x="318" y="238" as="geometry" />
        </mxCell>
        <mxCell id="s_inact" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;INACTIVE [Chờ duyệt / Ngưng bán]&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;&lt;font style=&#39;font-size:9.5px;color:#222222&#39;&gt;Hàng đợi chờ duyệt GET /admin/stores/pending&lt;br&gt;(status=&#39;INACTIVE&#39;) hoặc tạm ẩn bởi Admin&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="280" x="500" y="130" as="geometry" />
        </mxCell>
        <mxCell id="s_act" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;ACTIVE [Cửa hàng Đang Hoạt động]&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;&lt;font style=&#39;font-size:9.5px;color:#222222&#39;&gt;AuthService.register/googleLogin hoặc /approve;&lt;br&gt;Mở khóa Storefront, Billing, Cấp phát Thiết bị,&lt;br&gt;Rentals, WebSocket Auto-join &amp; resolveAuthority()&lt;/font&gt;" vertex="1">
          <mxGeometry height="96" width="310" x="485" y="362" as="geometry" />
        </mxCell>
        <mxCell id="s_susp" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;verticalAlign=middle;" value="&lt;b&gt;SUSPENDED [Tạm ngưng — Có thể Mở lại]&lt;/b&gt;&lt;hr size=&#39;1&#39;&gt;&lt;font style=&#39;font-size:9.5px;color:#222222&#39;&gt;POST /admin/stores/:id/reject (bắt buộc reason)&lt;br&gt;hoặc PATCH /admin/stores/:id {SUSPENDED}&lt;br&gt;(Chưa có API xóa/đóng vĩnh viễn -&gt; không nối Final)&lt;/font&gt;" vertex="1">
          <mxGeometry height="92" width="280" x="930" y="244" as="geometry" />
        </mxCell>
        <mxCell id="n_st11" parent="1" style="rounded=1;arcSize=8;dashed=1;dashPattern=5 3;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#666666;strokeWidth=1.2;fontColor=#111111;fontSize=9.5;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;Lưu ý Quan trọng từ Mã nguồn (Không có trạng thái kết thúc sớm):&lt;/b&gt;&lt;br&gt;• Schema mặc định &lt;code&gt;status = &#39;ACTIVE&#39;&lt;/code&gt;; &lt;i&gt;UpdateAdminStoreDto&lt;/i&gt; chỉ cho phép 3 giá trị: &lt;code&gt;ACTIVE | INACTIVE | SUSPENDED&lt;/code&gt; (không có &lt;code&gt;PENDING&lt;/code&gt; hay &lt;code&gt;REJECTED&lt;/code&gt;).&lt;br&gt;• &lt;code&gt;SUSPENDED&lt;/code&gt; vẫn có thể khôi phục về &lt;code&gt;ACTIVE&lt;/code&gt; qua &lt;code&gt;PATCH /admin/stores/:id { status: &#39;ACTIVE&#39; }&lt;/code&gt; và chưa có hành động xóa/đóng vĩnh viễn Store nên không đặt trạng thái Final.&lt;br&gt;• &lt;code&gt;POST /admin/stores/:id/approve&lt;/code&gt; đồng thời cập nhật &lt;i&gt;store.status = &#39;ACTIVE&#39;&lt;/i&gt; và &lt;i&gt;user.status = &#39;ACTIVE&#39;&lt;/i&gt;; các luồng đặt hàng, thuê nút, cấp phát nút, ví Store và WS room đều yêu cầu &lt;code&gt;ACTIVE&lt;/code&gt;." vertex="1">
          <mxGeometry height="116" width="1150" x="60" y="540" as="geometry" />
        </mxCell>
        <mxCell id="page_st11_store_lifecycle_t1" edge="1" parent="1" source="st_init" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.3;endArrow=open;endFill=0;fontColor=#000000;fontSize=9.5;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;" target="c_store" value="registerStoreOwnerTx()">
