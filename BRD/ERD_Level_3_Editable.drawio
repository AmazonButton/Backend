  <diagram id="page_store_withdrawal_lifecycle" name="[STATE 3] Store Withdrawal">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1520" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s3_note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;fontColor=#333333;fillColor=#F8F9FA;strokeColor=#D5D5D5;strokeWidth=1;spacing=8;" value="&lt;b&gt;State Machine: Store Withdrawal Lifecycle&lt;/b&gt;&lt;br&gt;Tuân thủ kiến trúc CAS (Compare-And-Swap) và Payout tự động PayOS. Không chuyển thẳng FAILED/SUCCEEDED khi timeout mà giữ PENDING_RECONCILIATION." vertex="1">
          <mxGeometry x="40" y="20" width="1440" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s3_init" parent="1" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry x="206" y="160" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s3_st_pending" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;PENDING&lt;/b&gt;&lt;br&gt;Request withdrawal;&lt;br&gt;Lock wallet &amp; reserve balance;&lt;br&gt;Snapshot encrypted bank details." vertex="1">
          <mxGeometry x="105" y="220" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s3_st_rejected" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;REJECTED&lt;/b&gt;&lt;br&gt;Authorized reject before dispatch;&lt;br&gt;Unfreeze wallet balance atomically;&lt;br&gt;Audit log persisted." vertex="1">
          <mxGeometry x="465" y="220" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s3_fin_rejected" parent="1" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry x="566" y="330" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s3_st_recon" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;PENDING_RECONCILIATION&lt;/b&gt;&lt;br&gt;Network timeout / 403 / unknown;&lt;br&gt;Frozen balance retained strictly;&lt;br&gt;Admin manual query / resolve." vertex="1">
          <mxGeometry x="465" y="530" width="230" height="85" as="geometry" />
        </mxCell>
        <mxCell id="s3_st_processing" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;PROCESSING&lt;/b&gt;&lt;br&gt;CAS transition to prevent race;&lt;br&gt;Submit stable payout reference&lt;br&gt;via automated PayOS Payout API." vertex="1">
          <mxGeometry x="825" y="380" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s3_st_succeeded" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;SUCCEEDED&lt;/b&gt;&lt;br&gt;Verified terminal success (webhook/reconcile);&lt;br&gt;Deduct frozen balance permanently;&lt;br&gt;Write financial transaction ledger." vertex="1">
          <mxGeometry x="825" y="690" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3_fin_succeeded" parent="1" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry x="926" y="810" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s3_st_failed" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;FAILED&lt;/b&gt;&lt;br&gt;Verified terminal error from bank/PayOS;&lt;br&gt;Restore reserved balance to available;&lt;br&gt;Record failure reason." vertex="1">
          <mxGeometry x="825" y="880" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3_fin_failed" parent="1" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry x="926" y="990" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s3_st_payos_exec" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;PAYOS_EXECUTING&lt;/b&gt;&lt;br&gt;Napas 247 Interbank Transfer;&lt;br&gt;Validate IP whitelist &amp; signature." vertex="1">
          <mxGeometry x="1185" y="380" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s3_e0" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" source="s3_init" target="s3_st_pending" value="Request [Balance &gt;= Min]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3_e1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" source="s3_st_pending" target="s3_st_rejected" value="Admin Rejects">
