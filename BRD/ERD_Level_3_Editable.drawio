        <mxCell id="pool_bnk" value="STORE BANK ACCOUNT PENNY-DEPOSIT VERIFICATION (VÒNG ĐỜI XÁC THỰC TÀI KHOẢN NGÂN HÀNG)" style="swimlane;startSize=30;horizontal=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14;" vertex="1" parent="1">
