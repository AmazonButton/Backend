          <mxGeometry x="40" y="20" width="1440" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pool_a4" parent="1" style="swimlane;startSize=30;horizontal=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=13;" value="ACTIVITY DIAGRAM: STORE WALLET PAYOUT &amp; RECONCILIATION" vertex="1">
          <mxGeometry x="40" y="80" width="1440" height="1100" as="geometry" />
        </mxCell>
        <mxCell id="lane_a4_owner" parent="pool_a4" style="swimlane;horizontal=1;startSize=36;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=11;collapsible=0;" value="Store Owner (Chủ cửa hàng)" vertex="1">
