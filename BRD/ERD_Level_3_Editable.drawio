        <mxCell id="s6_note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;fontColor=#333333;fillColor=#F8F9FA;strokeColor=#D5D5D5;strokeWidth=1;spacing=8;" value="&lt;b&gt;State Machine: Hardware Warranty Ticket &amp;amp; Deposit Deduction Lifecycle&lt;/b&gt;&lt;br&gt;SYSTEM_STAFF xử lý thẩm định kỹ thuật (1-1 Swap / Lock for Refund), tách biệt hoàn toàn với quyết toán hoàn cọc tài chính của Admin." vertex="1">
          <mxGeometry x="40" y="20" width="1200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s6_init" parent="1" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" value="" vertex="1">
          <mxGeometry x="226" y="160" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s6_st_open" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;PENDING&lt;/b&gt;&lt;br&gt;Ticket created (Group A/B/C/D);&lt;br&gt;Snapshots rentalId &amp;amp; depositAmount;&lt;br&gt;Blocks duplicate PENDING ticket." vertex="1">
          <mxGeometry x="125" y="220" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s6_st_closed" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;SWAPPED / RESOLVED&lt;/b&gt;&lt;br&gt;SYSTEM_STAFF approves 1-1 swap (Group A)&lt;br&gt;or resolves config issue;&lt;br&gt;Replacement inherits rental &amp;amp; config." vertex="1">
          <mxGeometry x="125" y="380" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s6_st_handed" parent="1" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;LOCKED_FOR_REFUND&lt;/b&gt;&lt;br&gt;SYSTEM_STAFF locks defective button;&lt;br&gt;Queues DepositRefund (PENDING_APPROVAL);&lt;br&gt;Single ledger settlement by Admin." vertex="1">
          <mxGeometry x="525" y="380" width="230" height="80" as="geometry" />
        </mxCell>
