        <mxCell id="page_st_sup1_didit_ekyc_note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11.5;fontColor=#000000;fillColor=#F8F9FA;strokeColor=#000000;strokeWidth=1.2;" value="&lt;b&gt;ST-SUP1 — Vòng đời Phiên eKYC Didit &amp; Trạng thái KYC Tài khoản (Hai Máy Độc lập)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;color:#333333&#39;&gt;Loại bỏ Fork/Join gộp kết thúc chung | Bảng CustomerProfile KHÔNG có cột ekycStatus; KYC lưu trên User.kycStatus với chống hạ cấp từ APPROVED&lt;/font&gt;" vertex="1">
