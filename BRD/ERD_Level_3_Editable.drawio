  <diagram id="page_act_store_payout" name="[ACT 4] Store Wallet Payout">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1520" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
