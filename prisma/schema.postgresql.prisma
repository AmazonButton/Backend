datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                        String           @id @default(uuid())
  email                     String           @unique
  username                  String?          @unique
  passwordHash              String
  fullName                  String
  phone                     String?
  role                      String           @default("CUSTOMER") // SUPER_ADMIN, STORE_OWNER, STORE_MANAGER, STORE_STAFF, CUSTOMER, TECHNICIAN
  isActive                  Boolean          @default(true)
  emailVerified             Boolean          @default(false)
  emailVerificationToken    String?
  emailVerificationExpires  DateTime?
  passwordResetTokenHash    String?
  passwordResetExpires      DateTime?
  failedLoginAttempts       Int              @default(0)
  lockedUntil               DateTime?
  lastLoginAt               DateTime?
  storeId                   String?
  store                     Store?           @relation(fields: [storeId], references: [id])
  customerProfile           CustomerProfile?
  refreshSessions           RefreshSession[]
  auditLogs                 AuditLog[]
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  ipAddress String?
  userAgent String?

  @@index([userId])
}

model Store {
  id              String            @id @default(uuid())
  name            String
  code            String            @unique
  ownerName       String
  phone           String
  email           String
  address         String
  status          String            @default("PENDING_APPROVAL") // PENDING_APPROVAL, ACTIVE, SUSPENDED, REJECTED
  rejectionReason String?
  approvedAt      DateTime?
  users           User[]
  products        Product[]
  devices         Device[]
  deviceTemplates DeviceTemplate[]
  customers       CustomerProfile[]
  orders          Order[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model CustomerProfile {
  id              String                 @id @default(uuid())
  userId          String                 @unique
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId         String
  store           Store                  @relation(fields: [storeId], references: [id])
  apartment       String?
  building        String?
  floor           String?
  room            String?
  deliveryAddress String
  phone           String
  devices         Device[]
  pairingSessions DevicePairingSession[]
  orders          Order[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model Product {
  id              String                @id @default(uuid())
  storeId         String
  store           Store                 @relation(fields: [storeId], references: [id])
  name            String
  brand           String
  sku             String
  description     String?
  category        String // "Nước uống", "Gas", "Gạo", "Sữa", "Nhu yếu phẩm"
  unit            String // "Bình 20L", "Bình 12kg", "Bao 25kg", "Thùng 24 lon"
  price           Float
  stock           Int                   @default(0)
  reservedStock   Int                   @default(0)
  minStockAlert   Int                   @default(5)
  imageUrl        String?
  status          String                @default("ACTIVE") // ACTIVE, INACTIVE, OUT_OF_STOCK
  isActive        Boolean               @default(true)
  devices         Device[]
  deviceConfigs   DeviceConfiguration[]
  deviceTemplates DeviceTemplate[]
  orderItems      OrderItem[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([storeId, sku])
}

model Device {
  id                  String                 @id @default(uuid())
  deviceId            String                 @unique // e.g. "SOB-000001", "BTN-8829-WTR"
  serialNumber        String                 @unique
  macAddress          String?                @unique // e.g. "24:6F:28:AB:CD:01"
  customName          String?                // e.g. "Water Button 01" / Alias "WATER-001"
  deviceSecret        String // HMAC secret key
  claimCode           String // e.g. "CLAIM-749201"
  pairingCode         String?                // 6-digit numeric pairing code e.g. "882910"
  pairingToken        String?                // Secure random pairing token for QR payload
  qrPayload           String                 @unique // e.g. "SOBPAIR://setup?device=SOB-000001&token=XXXXXX&v=1"
  firmwareVersion     String                 @default("1.0.0")
  hardwareModel       String                 @default("ESP32-WROOM-32E")
  status              String                 @default("READY_FOR_CUSTOMER") // MANUFACTURED, INVENTORY, ASSIGNED_TO_STORE, READY_FOR_CUSTOMER, PROVISIONING, WIFI_CONFIGURED, CLOUD_CONNECTED, CLAIMED, ACTIVE, DISABLED, REVOKED, TRANSFER_PENDING
  claimStatus         String                 @default("UNCLAIMED") // UNCLAIMED, PENDING_CLAIM, CLAIMED, TRANSFERRED
  provisioningStatus  String                 @default("UNPROVISIONED") // UNPROVISIONED, BLE_ADVERTISING, PROVISIONING, WIFI_CONFIGURED, CLOUD_CONNECTED, FAILED
  ipAddress           String?                // Technical telemetry only
  uptime              Int?                   // In seconds
  storeId             String?
  store               Store?                 @relation(fields: [storeId], references: [id])
  productId           String?
  product             Product?               @relation(fields: [productId], references: [id])
  templateId          String?
  template            DeviceTemplate?        @relation(fields: [templateId], references: [id])
  location            String?                // e.g. "Kitchen B2", "Warehouse 1"
  description         String?
  customerId          String?
  customer            CustomerProfile?       @relation(fields: [customerId], references: [id])
  batteryLevel        Int                    @default(100)
  wifiRSSI            Int                    @default(-50)
  lastSeenAt          DateTime?
  configuration       DeviceConfiguration?
  pairingSessions     DevicePairingSession[]
  auditLogsExtended   DeviceAuditLog[]
  events              DeviceEvent[]
  telemetries         DeviceTelemetry[]
  orders              Order[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
}

model DevicePairingSession {
  id         String           @id @default(uuid())
  deviceId   String
  device     Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tokenHash  String           @unique
  customerId String?
  customer   CustomerProfile? @relation(fields: [customerId], references: [id])
  expiresAt  DateTime
  usedAt     DateTime?
  status     String           @default("ACTIVE") // ACTIVE, USED, EXPIRED, REVOKED
  createdAt  DateTime         @default(now())
}

model DeviceAuditLog {
  id        String   @id @default(uuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  actorId   String?
  action    String   // WIFI_CONFIGURED, BOOTSTRAP_SUCCESS, DEVICE_CLAIMED, DEVICE_UNCLAIMED, etc.
  metadata  String?  // JSON metadata
  createdAt DateTime @default(now())
}

model DeviceTemplate {
  id                  String   @id @default(uuid())
  name                String   // e.g. "WATER BUTTON", "LPG GAS BUTTON"
  description         String?
  category            String?  // "Water", "Gas", "Rice"
  storeId             String?
  store               Store?   @relation(fields: [storeId], references: [id])
  defaultProductId    String?
  defaultProduct      Product? @relation(fields: [defaultProductId], references: [id])
  singlePressAction   String   @default("CREATE_ORDER")
  doublePressAction   String   @default("CANCEL_ORDER")
  longPressAction     String   @default("WIFI_CONFIGURATION")
  defaultQuantity     Int      @default(1)
  cancelWindowSeconds Int      @default(60)
  devices             Device[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model DeviceConfiguration {
  id                    String   @id @default(uuid())
  deviceId              String   @unique
  device                Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  customName            String // e.g. "Nút Nước Lavie Bếp"
  productId             String
  product               Product  @relation(fields: [productId], references: [id])
  defaultQuantity       Int      @default(1)
  allowCustomerQuantity Boolean  @default(false)
  allowCustomerProduct  Boolean  @default(false)
  quickOrderDirect      Boolean  @default(true)
  cancelWindowSeconds   Int      @default(60)
  soundEnabled          Boolean  @default(true)
  ledEnabled            Boolean  @default(true)
  version               Int      @default(1)
  updatedByUserId       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model DeviceEvent {
  id           String   @id @default(uuid())
  deviceId     String
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  eventType    String // "SINGLE_PRESS", "DOUBLE_PRESS", "HOLD_5S", "LOW_BATTERY"
  requestId    String   @unique
  batteryLevel Int
  wifiRSSI     Int
  rawPayload   String?
  processed    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model DeviceTelemetry {
  id              String   @id @default(uuid())
  deviceId        String
  device          Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  batteryLevel    Int
  voltageMv       Int
  wifiRSSI        Int
  bootReason      String
  wakeDurationMs  Int
  firmwareVersion String
  createdAt       DateTime @default(now())
}

model Order {
  id                 String           @id @default(uuid())
  orderNumber        String           @unique // e.g. "ORD-20260902-0041"
  storeId            String
  store              Store            @relation(fields: [storeId], references: [id])
  customerId         String
  customer           CustomerProfile  @relation(fields: [customerId], references: [id])
  deviceId           String?
  device             Device?          @relation(fields: [deviceId], references: [id])
  status             String           @default("PENDING") // PENDING, CONFIRMED, PREPARING, OUT_FOR_DELIVERY, COMPLETED, CANCELLED, REJECTED
  totalAmount        Float
  deliveryAddress    String
  customerPhone      String
  customerName       String
  cancelExpiresAt    DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  items              OrderItem[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
}

model IdempotencyRecord {
  key       String   @id
  deviceId  String
  orderId   String?
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  oldValues String?
  newValues String?
  ipAddress String?
  createdAt DateTime @default(now())
}
